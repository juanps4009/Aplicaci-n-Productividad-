<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="Widget de Pendientes"
            android:textColor="@color/text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="20dp"
            android:paddingTop="6dp"
            android:text="Ve tus tareas pendientes, con su prioridad, en la pantalla de inicio. Al tocar una, se abre en la app."
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="SERVIDOR"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Opción 1: el servidor de la app (un toque, sin escribir nada) -->
        <LinearLayout
            android:id="@+id/card_default"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:id="@+id/mark_default"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:text="○"
                android:textColor="@color/accent"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Usar el servidor de la app"
                    android:textColor="@color/text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="2dp"
                    android:text="Recomendado. No tienes que escribir ninguna dirección."
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Opción 2: servidor propio -->
        <LinearLayout
            android:id="@+id/card_custom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_bg"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/mark_custom"
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:text="○"
                    android:textColor="@color/accent"
                    android:textSize="22sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Usar mi propio servidor"
                        android:textColor="@color/text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="2dp"
                        android:text="Para quien creó su propio servidor."
                        android:textColor="@color/muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <EditText
                android:id="@+id/server"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/input_bg"
                android:hint="https://avisos.tu-usuario.workers.dev"
                android:inputType="textUri"
                android:padding="14dp"
                android:textColor="@color/text"
                android:textColorHint="@color/faint"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:paddingTop="24dp"
            android:text="TU CÓDIGO DE SINCRONIZACIÓN"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/code"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/input_bg"
                android:hint="XXXX-XXXX-XXXX-XXXX-XXXX"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:padding="14dp"
                android:textColor="@color/text"
                android:textColorHint="@color/faint"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/paste"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="8dp"
                android:background="@drawable/btn_secondary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:text="Pegar"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="Lo ves en la app: Ajustes → Sincronizar. Cópialo y toca «Pegar»."
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:textColor="@color/danger"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Guardar"
            android:textColor="@color/on_accent"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hint_after"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="Después, mantén pulsado un espacio vacío de tu pantalla de inicio → Widgets → Pendientes."
            android:textColor="@color/muted"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de llamada con Claude: suena, contestar/rechazar, y durante la llamada silencio, altavoz y colgar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/call_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="40dp"
        android:text="Claude"
        android:textColor="@color/text"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/call_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="6dp"
        android:textColor="@color/muted"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/call_reason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/card_bg"
        android:padding="16dp"
        android:textColor="@color/text"
        android:textSize="16sp" />

    <ScrollView
        android:id="@+id/call_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/call_transcript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/muted"
            android:textIsSelectable="true"
            android:textSize="15sp" />
    </ScrollView>

    <!-- Sonando: rechazar o contestar -->
    <LinearLayout
        android:id="@+id/row_ringing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_decline"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/btn_danger"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Rechazar"
            android:textColor="@color/on_accent"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_answer"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/btn_answer"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Contestar"
            android:textColor="@color/on_accent"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- En llamada: silencio, altavoz, colgar -->
    <LinearLayout
        android:id="@+id/row_talking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_mute"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/btn_round"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Silenciar"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btn_speaker"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/btn_round"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Altavoz"
                android:textColor="@color/text"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_hangup"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_danger"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Colgar"
            android:textColor="@color/on_accent"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Terminada -->
    <TextView
        android:id="@+id/btn_close"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/btn_secondary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="Cerrar"
        android:textColor="@color/text"
        android:textSize="16sp" />
</LinearLayout>
